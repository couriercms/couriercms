# Select before compiling the platform. Local uses SQLite and Server uses
# PostgreSQL; separate artifacts/build directories prevent adapter mixing.
COURIERCMS_RELEASE_PROFILE=server
# Local profile only. Development defaults to .local/couriercms_dev.db.
COURIERCMS_SQLITE_PATH=

# PostgreSQL defaults match compose.yaml and are for local development only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=couriercms
POSTGRES_PASSWORD=couriercms_dev
POSTGRES_DB=couriercms_dev
POSTGRES_TEST_DB=couriercms_test

# Optional Windows workaround when OTP cannot read the Windows certificate
# store. Git for Windows commonly provides this PEM bundle:
# C:/Program Files/Git/usr/ssl/cert.pem
COURIERCMS_CACERTS_PATH=
COURIERCMS_INSTALLATION_ID=
COURIERCMS_BOOTSTRAP_OWNER_EMAIL=

# Production magic-link email delivery.
MAIL_FROM_NAME=CourierCMS
MAIL_FROM_ADDRESS=
SMTP_RELAY=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false

# Generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
COURIERCMS_VAULT_KEY=
COURIERCMS_VAULT_KEY_VERSION=1
# During rotation, set the former key and version, deploy, run
# CourierCMS.Security.VaultRotation.rotate!(), then remove both old values.
COURIERCMS_PREVIOUS_VAULT_KEY=
COURIERCMS_PREVIOUS_VAULT_KEY_VERSION=

# Production release settings.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA_CERTFILE=
POOL_SIZE=10
POOL_COUNT=1
DB_QUEUE_TARGET_MS=50
DB_QUEUE_INTERVAL_MS=1000
SECRET_KEY_BASE=
PHX_HOST=localhost
PORT=4000

# Runtime topology. "all" preserves the single-process local setup.
COURIERCMS_ROLE=all
# Worker/all nodes only. Available queues: route_planning, delivery, webhooks,
# maintenance. Leave blank for defaults.
COURIERCMS_QUEUES=
# Combined nodes keep the scheduler enabled by default. Worker-only nodes keep
# it disabled unless exactly one designated worker sets this to true.
COURIERCMS_SCHEDULER_ENABLED=
# Oban defaults to 15000 milliseconds when this is blank.
COURIERCMS_SHUTDOWN_GRACE_PERIOD_MS=
# Lease used to serialize one logical Delivery Item across worker machines.
COURIERCMS_DELIVERY_LOCK_TTL_MS=900000
COURIERCMS_MAX_SOURCE_PAGE_ITEMS=1000
COURIERCMS_MAX_RUN_ITEMS=100000
COURIERCMS_MAX_PLANNING_PAGES=10000
COURIERCMS_MAX_DELIVERY_BYTES=5000000
# Maximum wall-clock time for one trusted Processor callback.
COURIERCMS_PROCESSOR_TIMEOUT_MS=30000
COURIERCMS_MAX_ASSET_BYTES=250000000
COURIERCMS_MAX_CONTENT_BUNDLE_NODES=500
COURIERCMS_MAX_CONTENT_BUNDLE_RELATIONSHIPS=2000
COURIERCMS_MAX_CONTENT_BUNDLE_ASSETS=500
COURIERCMS_DELIVERY_MAX_ATTEMPTS=3
COURIERCMS_ASSET_DELIVERY_MAX_ATTEMPTS=3
COURIERCMS_PLANNING_MAX_ATTEMPTS=3
COURIERCMS_DELIVERY_BACKOFF_CAP_SECONDS=30
COURIERCMS_ASSET_DELIVERY_BACKOFF_CAP_SECONDS=30
COURIERCMS_PLANNING_BACKOFF_CAP_SECONDS=30
COURIERCMS_MAX_ADAPTER_RESPONSE_BYTES=10000000
COURIERCMS_MAX_WEBHOOK_BYTES=64000
COURIERCMS_ADAPTER_CONNECT_TIMEOUT_MS=5000
COURIERCMS_ADAPTER_RECEIVE_TIMEOUT_MS=30000
COURIERCMS_ASSET_RECEIVE_TIMEOUT_MS=300000
# Optional controlled temporary directory for streamed Delivery Assets.
# COURIERCMS_ASSET_TEMP_PATH=C:/CourierCMS/tmp/assets
COURIERCMS_DEFAULT_CONNECTION_CONCURRENCY=5
COURIERCMS_DEFAULT_CONNECTION_REQUESTS_PER_SECOND=20
COURIERCMS_HEARTBEAT_ENABLED=true
COURIERCMS_REQUIRE_WORKER_READINESS=true
COURIERCMS_REQUIRE_EXTENSION_CONSISTENCY=true
# At least 32 characters; required to scrape /metrics in production.
COURIERCMS_METRICS_TOKEN=
COURIERCMS_STRANDED_AFTER_MS=1200000
COURIERCMS_RETENTION_ENABLED=false
COURIERCMS_RUN_RETENTION_DAYS=365
COURIERCMS_EVENT_RETENTION_DAYS=90
COURIERCMS_AUDIT_RETENTION_DAYS=730
COURIERCMS_RETENTION_BATCH_SIZE=500
COURIERCMS_FAILURE_EMAIL_ALERTS=true
COURIERCMS_ALLOW_HTTP_CMS_ENDPOINTS=false
COURIERCMS_ALLOW_PRIVATE_NETWORKS=false
COURIERCMS_ALLOW_UNSAFE_LOCAL_ENDPOINTS=false

# Trusted native OTP Extension packages are loaded only at node startup.
COURIERCMS_EXTENSIONS_PATH=
COURIERCMS_EXTENSION_CACHE_DIR=
COURIERCMS_EXTENSION_SIGNATURE_POLICY=optional
# Comma-separated Ed25519 keyId:base64-public-key entries.
COURIERCMS_EXTENSION_TRUSTED_KEYS=
COURIERCMS_EXTENSION_MAX_PACKAGE_BYTES=50000000
COURIERCMS_EXTENSION_MAX_UNCOMPRESSED_BYTES=200000000
COURIERCMS_EXTENSION_MAX_ENTRIES=5000
COURIERCMS_EXTENSION_MAX_PACKAGES=100
